<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARS Recruitment</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <nav class="navbar navbar-expand-lg navbar-dark bg-transparent py-0">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="bi bi-briefcase-fill text-white fs-5"></i>
                    </div>
                    <span>ARS<span class="text-primary-light fw-normal fs-5">.Jobs</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Job" asp-action="Index"><i class="bi bi-search me-1"></i> Tìm việc làm</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.HasClaim("Permission", "ApplyJob"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Candidate" asp-action="MyApplications"><i class="bi bi-file-earmark-check me-1"></i> Việc làm đã ứng tuyển</a>
                            </li>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Recruiter"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="JobPosting" asp-action="Index"><i class="bi bi-plus-circle me-1"></i> Tin tuyển dụng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Company" asp-action="Index"><i class="bi bi-building me-1"></i> Hồ sơ công ty</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2 fw-semibold fs-7" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-primary-light"></i>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item py-2" href="#"><i class="bi bi-person me-2 text-primary"></i> Trang cá nhân</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold fs-7">Đăng nhập</a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-search-hero rounded-pill px-4 py-2 text-white fw-bold fs-7 shadow-sm">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="container">
            <div class="row gy-4 mb-5">
                <div class="col-lg-4 col-md-6">
                    <a class="d-flex align-items-center gap-2 text-white fw-bold fs-4 text-decoration-none mb-3" href="#">
                        <div class="brand-icon-box">
                            <i class="bi bi-briefcase-fill text-white fs-5"></i>
                        </div>
                        <span>ARS<span class="text-primary-light fw-normal fs-5">.Jobs</span></span>
                    </a>
                    <p class="text-muted pe-lg-4 mb-4">Nền tảng kết nối ứng viên và nhà tuyển dụng công nghệ hàng đầu tại Việt Nam. Tìm kiếm việc làm mơ ước chỉ trong vài cú nhấp chuột.</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-github"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">Dành cho ứng viên</h6>
                    <ul class="footer-links">
                        <li><a href="/Job">Tìm việc làm mới</a></li>
                        <li><a href="/Job?workMode=1">Việc làm Remote</a></li>
                        <li><a href="/Job?jobType=0">Tuyển dụng Full-time</a></li>
                        <li><a href="#">Tạo mẫu CV chuẩn</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Ngành nghề nổi bật</h6>
                    <ul class="footer-links">
                        <li><a href="/Job?categoryId=1">Công nghệ thông tin</a></li>
                        <li><a href="/Job?categoryId=2">Kinh doanh / Bán hàng</a></li>
                        <li><a href="/Job?categoryId=3">Marketing / Truyền thông</a></li>
                        <li><a href="/Job?categoryId=4">Thiết kế đồ họa / UI/UX</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Đăng ký nhận bản tin</h6>
                    <p class="text-muted small mb-3">Nhận thông báo các việc làm HOT nhất trực tiếp qua Email của bạn.</p>
                    <form class="d-flex gap-2 mb-3">
                        <input type="email" class="form-control bg-glass-dark text-white border-secondary rounded-pill px-3 py-2 small" placeholder="Email của bạn...">
                        <button type="button" class="btn btn-primary rounded-pill px-3"><i class="bi bi-send-fill"></i></button>
                    </form>
                </div>
            </div>

            <div class="border-top border-secondary border-opacity-25 pt-4 text-center text-muted small">
                &copy; @DateTime.Now.Year ARS Recruitment Platform. Tất cả quyền được bảo lưu. Thiết kế giao diện sang trọng chuẩn Web App.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        $(window).scroll(function() {
            if ($(this).scrollTop() > 30) {
                $('.main-header').addClass('scrolled');
            } else {
                $('.main-header').removeClass('scrolled');
            }
        });
    </script>
</body>
</html>

