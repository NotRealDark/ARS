<!-- CATEGORIES SECTION -->
<section class="py-5" style="margin-top: 3rem; margin-bottom: 3rem;">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-5 gap-3">
            <div>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold mb-2">NGÀNH NGHỀ PHỔ BIẾN</span>
                <h2 class="section-title">Danh Mục Ngành Nghề HOT</h2>
                <p class="section-subtitle mb-0">Khám phá công việc phù hợp theo đúng lĩnh vực của bạn</p>
            </div>
            <a href="/Job" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                Xem tất cả danh mục <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (ViewBag.Categories != null)
            {
                var categories = (IEnumerable<dynamic>)ViewBag.Categories;
                var icons = new[] { "bi-code-slash", "bi-graph-up-arrow", "bi-megaphone-fill", "bi-palette-fill", "bi-cpu-fill", "bi-building", "bi-cash-coin", "bi-headset" };
                int iconIndex = 0;

                foreach (var cat in categories)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <a href="/Job?categoryId=@cat.Id" class="text-decoration-none">
                            <div class="category-card">
                                <div class="category-icon-bg">
                                    <i class="bi @icons[iconIndex % icons.Length]"></i>
                                </div>
                                <h5 class="category-name">@cat.Name</h5>
                                <span class="category-count">@cat.JobCount Việc làm</span>
                            </div>
                        </a>
                    </div>
                    iconIndex++;
                }
            }
        </div>
    </div>
</section>

<!-- LATEST JOBS SECTION -->
<section class="py-5 bg-light position-relative">
    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-5 gap-3">
            <div>
                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 fw-semibold mb-2">CƠ HỘI MỚI NHẤT</span>
                <h2 class="section-title mb-1">Việc Làm Đang Tuyển Gấp</h2>
                <p class="section-subtitle mb-0">Ứng tuyển ngay để không bỏ lỡ các vị trí hấp dẫn nhất</p>
            </div>
            <a href="/Job" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm">
                Khám phá tất cả việc làm <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (ViewBag.LatestJobs != null)
            {
                foreach (var job in ViewBag.LatestJobs)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="job-card">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                @{
                                    var logoUrl = ExtractLogoSrc(job.CompanyLogoPath);
                                }
                                <div class="company-logo-box">
                                    @if (!string.IsNullOrEmpty(logoUrl))
                                    {
                                        <img src="@logoUrl" alt="@job.CompanyName">
                                    }
                                    else
                                    {
                                        <span>@(string.IsNullOrEmpty(job.CompanyName) ? "J" : job.CompanyName.Substring(0, 1).ToUpper())</span>
                                    }
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <a href="/Job/Detail/@job.Id" class="job-title-link text-truncate d-block" title="@job.Title">@job.Title</a>
                                    <div class="company-name-text text-truncate">@job.CompanyName</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="salary-badge mb-3">
                                    <i class="bi bi-cash-stack fs-6"></i>
                                    <span>@FormatSalary(job.MinSalary, job.MaxSalary)</span>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge-tag badge-purple">
                                        <i class="bi bi-briefcase me-1"></i> @job.JobTypeName
                                    </span>
                                    <span class="badge-tag badge-cyan">
                                        <i class="bi bi-laptop me-1"></i> @job.WorkModeName
                                    </span>
                                    <span class="badge-tag badge-orange">
                                        <i class="bi bi-geo-alt me-1"></i> @job.Location
                                    </span>
                                </div>
                            </div>

                            <div class="mt-auto pt-3 border-top border-light-subtle d-flex align-items-center justify-content-between">
                                <span class="text-muted extra-small" style="font-size:0.8rem;">
                                    <i class="bi bi-clock me-1"></i> Mới đăng
                                </span>
                                <a href="/Job/Detail/@job.Id" class="btn btn-detail-card btn-sm px-4">
                                    Ứng tuyển ngay <i class="bi bi-chevron-right ms-1 small"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- HOW IT WORKS SECTION -->
