@{
    ViewData["Title"] = "Trang chủ - ARS Recruitment";
}

@functions {
    public string FormatSalary(int? min, int? max)
    {
        if (min.HasValue && max.HasValue)
            return $"{min.Value / 1000000} - {max.Value / 1000000} Triệu";
        if (min.HasValue)
            return $"Từ {min.Value / 1000000} Triệu";
        if (max.HasValue)
            return $"Đến {max.Value / 1000000} Triệu";
        return "Thỏa thuận";
    }

    public string ExtractLogoSrc(object? logoPath)
    {
        if (logoPath == null) return "";
        string str = logoPath.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(str)) return "";
        if (str.Contains("src='"))
        {
            var parts = str.Split("src='");
            if (parts.Length > 1) return parts[1].Split("'")[0];
        }
        if (str.Contains("src=\""))
        {
            var parts = str.Split("src=\"");
            if (parts.Length > 1) return parts[1].Split("\"")[0];
        }
        return str;
    }
}

